{
  "name": "shared-folder-sync",
  "version": "0.3.0",
  "description": "Share one folder (and a Base) with another Obsidian user through a Google Apps Script mailbox.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/parser": "8.72.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "obsidian": "1.13.1",
    "tslib": "2.9.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "node-diff3": "4.0.0"
  }
}
